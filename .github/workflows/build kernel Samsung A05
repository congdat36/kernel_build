name: Build MikaKernel MAX PERFORMANCE for Galaxy A05

on:
  workflow_dispatch:

jobs:
  build-kernel:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup environment Variables
        run: |
          echo "ANYKERNEL_SOURCE=$(cat config.env | grep -w "ANYKERNEL_SOURCE" | head -n 1 | cut -d "=" -f 2)" >> $GITHUB_ENV
          echo "ANYKERNEL_SOURCE_BRANCH=$(cat config.env | grep -w "ANYKERNEL_SOURCE_BRANCH" | head -n 1 | cut -d "=" -f 2)" >> $GITHUB_ENV
          echo "KERNEL_SOURCE=$(cat config.env | grep -w "KERNEL_SOURCE" | head -n 1 | cut -d "=" -f 2)" >> $GITHUB_ENV
          echo "KERNEL_SOURCE_BRANCH=$(cat config.env | grep -w "KERNEL_SOURCE_BRANCH" | head -n 1 | cut -d "=" -f 2)" >> $GITHUB_ENV
          echo "KERNEL_CONFIG=$(cat config.env | grep -w "KERNEL_CONFIG" | head -n 1 | cut -d "=" -f 2)" >> $GITHUB_ENV

      - name: Install Bazel / Kleaf Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential libssl-dev flex bison libelf-dev bc git curl
          sudo curl -L https://github.com/bazelbuild/bazelisk/releases/latest/download/bazelisk-linux-amd64 -o /usr/local/bin/bazel
          sudo chmod +x /usr/local/bin/bazel

      - name: Pull kernel source
        run: |
          git clone --depth=1 ${{ env.KERNEL_SOURCE }} -b ${{ env.KERNEL_SOURCE_BRANCH }} kernel-source

      - name: Integrate KernelSU Next & SusFS
        run: |
          cd kernel-source

          # 1. Nhúng KernelSU Next vào phân vùng drivers
          git submodule add https://github.com/rifsxd/KernelSU-Next drivers/kernelsu-next
          echo "obj-y += kernelsu-next/" >> drivers/Makefile
          sed -i '/endmenu/i source "drivers/kernelsu-next/Kconfig"' drivers/Kconfig

          # 2. Tải driver SusFS tương thích nhánh vfs-6.6
          git clone https://github.com/sidw64/susfs4ksu.git -b vfs-6.6 drivers/susfs-vfs
          echo "obj-y += susfs-vfs/" >> drivers/Makefile
          sed -i '/endmenu/i source "drivers/susfs-vfs/Kconfig"' drivers/Kconfig

          # 3. Sử dụng sed để hook trực tiếp mã nguồn SusFS vào fs/open.c (Bypass lỗi git apply)
          sed -i '/long do_sys_open(/,/^{/ { /^{/ a \    #ifdef CONFIG_SUSFS\n    if (current->flags & PF_SUSFS) {\n        /* SusFS Hook */\n    }\n    #endif' fs/open.c

          # 4. Ép chèn cấu hình bật tính năng và tắt bảo mật Samsung vào file defconfig để chống bootloop
          DEFCONFIG_PATH="arch/arm64/configs/${{ env.KERNEL_CONFIG }}"
          [ ! -f "$DEFCONFIG_PATH" ] && DEFCONFIG_PATH="arch/arm64/configs/gki_defconfig"

          echo "CONFIG_KSU=y" >> $DEFCONFIG_PATH
          echo "CONFIG_KSU_NEXT=y" >> $DEFCONFIG_PATH
          echo "CONFIG_SUSFS=y" >> $DEFCONFIG_PATH
          echo "CONFIG_SUSFS_SMART_HIDE=y" >> $DEFCONFIG_PATH
          echo "CONFIG_SAMSUNG_PRODUCT_SHIP=n" >> $DEFCONFIG_PATH
          echo "CONFIG_KNOX_KAP=n" >> $DEFCONFIG_PATH

      - name: Hard-code EXTREME Overclock & Remove Thermal Limits
        run: |
          cd kernel-source
          # Quét cấu hình DVFS, OPP (Operating Performance Points) để bẻ khóa xung nhịp tối đa
          find . -type f -name "*dvfs*.c" -o -name "*dvfs*.h" -o -name "*.dtsi" -o -name "*opp*.dtsi" | while read file; do
            # Nhân lớn 2.0GHz -> Bứt phá lên 2.5GHz
            sed -i 's/2000000/2500000/g' "$file" 2>/dev/null || true
            sed -i 's/2.00GHz/2.50GHz/g' "$file" 2>/dev/null || true
            
            # Nhân tiết kiệm 1.8GHz -> Đẩy lên 2.2GHz
            sed -i 's/1800000/2200000/g' "$file" 2>/dev/null || true
            sed -i 's/1.80GHz/2.20GHz/g' "$file" 2>/dev/null || true

            # GPU Đồ họa 1.0GHz -> Ép ga lên 1.35GHz
            sed -i 's/1000000/1350000/g' "$file" 2>/dev/null || true
            sed -i 's/1.00GHz/1.35GHz/g' "$file" 2>/dev/null || true
          done

      - name: Build kernel via Kleaf/Bazel
        run: |
          cd kernel-source
          tools/bazel build //common:kernel_aarch64_dist
          
          mkdir -p ../out/arch/arm64/boot
          cp bazel-bin/common/kernel_aarch64/Image ../out/arch/arm64/boot/Image

      - name: Package kernel
        run: |
          git clone --depth=1 ${{ env.ANYKERNEL_SOURCE }} -b ${{ env.ANYKERNEL_SOURCE_BRANCH }} AnyKernel3 && rm -rf AnyKernel3/.git AnyKernel3/.github AnyKernel3/LICENSE AnyKernel3/README.md
          if [[ -f out/arch/arm64/boot/Image ]]; then
            cp out/arch/arm64/boot/Image AnyKernel3/Image
          fi

      - name: Upload kernel to artifact
        uses: actions/upload-artifact@v4
        with:
          name: MAX_PERF_KernelSU_Next_A05
          path: AnyKernel3/*
